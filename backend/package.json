  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker/worker.ts",
    "start:worker": "node dist/worker/worker.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx node_modules/node-pg-migrate/bin/node-pg-migrate up",
    "migrate:down": "tsx node_modules/node-pg-migrate/bin/node-pg-migrate down 1",
    "migrate:create": "node-pg-migrate create --migration-file-language ts",
    "seed": "tsx scripts/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaqibShafiq007/my-job-portal.git"
